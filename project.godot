; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Grimdark"
run/main_scene="res://scenes/main/game.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameConstants="*res://scripts/autoload/game_constants.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
PathfindingManager="*res://scripts/autoload/pathfinding_manager.gd"
WorldManager="*res://scripts/autoload/world_manager.gd"
DebugOverlay="*res://scripts/autoload/debug_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="Interactables"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
